# Docker Compose
POSTGRES_DB=marketexchange
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5555
BACKEND_PORT=8080

# Spring profile
SPRING_PROFILES_ACTIVE=local

# Database
# Supabase Session Pooler example, recommended for IPv4 local networks.
# Format: jdbc:postgresql://HOST:PORT/DATABASE?sslmode=require
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.tuvdcedzcvbcuczcctzk
DB_PASSWORD=

# Local Docker database alternative:
# DB_URL=jdbc:postgresql://localhost:5555/marketexchange
# DB_USERNAME=postgres
# DB_PASSWORD=

# JPA / Flyway
DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Auth
JWT_SECRET=
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Frontend / CORS
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email SMTP
# Leave empty when emails should not be sent from local development.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIRECTORY=uploads

# Supabase storage, only needed when STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=market-exchange-items
SUPABASE_CONNECT_TIMEOUT=5s
SUPABASE_READ_TIMEOUT=15s

# Seed data
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@marketexchange.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRSTNAME=Market
SEED_ADMIN_LASTNAME=Admin
SEED_ADMIN_PHONE=999999999
SEED_ADMIN_ADDRESS=Local admin address

SEED_USER1_EMAIL=cliente1@marketexchange.local
SEED_USER1_PASSWORD=
SEED_USER1_FIRSTNAME=Cliente
SEED_USER1_LASTNAME=Uno
SEED_USER1_PHONE=900000001
SEED_USER1_ADDRESS=Direccion cliente uno

SEED_USER2_EMAIL=cliente2@marketexchange.local
SEED_USER2_PASSWORD=
SEED_USER2_FIRSTNAME=Cliente
SEED_USER2_LASTNAME=Dos
SEED_USER2_PHONE=900000002
SEED_USER2_ADDRESS=Direccion cliente dos

# Logs / Actuator
SPRING_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
ACTUATOR_HEALTH_DETAILS=never
APP_VERSION=0.0.1-SNAPSHOT
