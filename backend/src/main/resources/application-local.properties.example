# Copia este archivo a application-local.properties (ignorado por git) y completa
# tus propios valores para desarrollo local. Nunca subas application-local.properties
# ni ningún archivo con credenciales reales al repositorio.
#
# Para usarlo: spring.profiles.active=local (o SPRING_PROFILES_ACTIVE=local)
# Estas mismas claves también pueden definirse como variables de entorno del sistema.

DB_URL=jdbc:postgresql://localhost:5555/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-a-long-random-string

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173
